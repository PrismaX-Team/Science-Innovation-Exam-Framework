# Optional controller environment template. The framework does NOT load .env.
# Copy to .env (ignored by Git), chmod 600, edit locally, then explicitly export:
#   set -a
#   . ./.env
#   set +a
# Only needed for agent.type=codex. Scripted CPU quickstart needs neither value.
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=
